# Copy this to .env.local and fill in values

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_keep_secret

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Benangbaju

# === DOKU Payment Gateway ===
NEXT_PUBLIC_DOKU_CHECKOUT_JS_URL=https://sandbox.doku.com/jokul-checkout-js/v1/jokul-checkout-1.0.0.js
DOKU_CLIENT_ID=your_doku_client_id
DOKU_SECRET_KEY=your_doku_secret_key

# === Email (Resend & Edge Function Secrets) ===
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Benangbaju <noreply@benangbaju.com>

# === Email (SMTP Fallback - Optional if RESEND_API_KEY is used) ===
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=Benangbaju <noreply@benangbaju.com>

# === External Services & Authentication ===
ERP_API_KEY=your_erp_api_key_keep_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here  
 
# === Social Links (Optional Overrides) ===
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/benangbaju
NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@benangbaju
NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/6285179747449
NEXT_PUBLIC_SOCIAL_SHOPEE=https://shopee.co.id/benangbaju

# === Analytics ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
